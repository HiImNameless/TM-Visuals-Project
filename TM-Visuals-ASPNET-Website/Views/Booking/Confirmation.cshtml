@model TMVisualsWebApp.Models.BookingConfirmationViewModel

@{
    ViewData["Title"] = "Booking Confirmation";

    var bookingDate = Model.Date?.ToString("dd MMMM yyyy") ?? "Not specified";

    var startTime = Model.StartTime.HasValue
        ? DateTime.Today.Add(Model.StartTime.Value).ToString("hh:mm tt")
        : "Not specified";

    var finishTime = Model.FinishTime.HasValue
        ? DateTime.Today.Add(Model.FinishTime.Value).ToString("hh:mm tt")
        : "Not specified";

    var budget = Model.Budget.HasValue
        ? $"R {Model.Budget.Value:N2}"
        : "Not specified";
}
@{
    var statusClass = Model.Status switch
    {
        "Confirmed" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Cancelled" => "bg-danger",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Success Message -->
            <div class="text-center mb-5">

                <div class="mb-3">
                    <div class="rounded-circle bg-success bg-opacity-10
                                d-inline-flex align-items-center justify-content-center"
                         style="width: 85px; height: 85px;">

                        <span class="text-success fs-1">&#10003;</span>

                    </div>
                </div>

                <h1 class="fw-bold mb-2">Booking Submitted!</h1>

                <p class="text-muted mb-0">
                    Your booking request has been successfully received.
                    Thank you for choosing TM Visuals.
                </p>

            </div>

            <!-- Booking Summary -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4 p-md-5">

                    <div class="d-flex justify-content-between
                                align-items-center mb-4">

                        <h4 class="fw-bold mb-0">Booking Summary</h4>

                        <span class="badge @statusClass px-3 py-2">
                            @Model.Status
                        </span>

                    </div>

                    <div class="mb-4">
                        <small class="text-muted d-block">
                            Booking Reference
                        </small>

                        <span class="fw-semibold">
                            #@Model.BookingId
                                           
                        </span>
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3">Customer Information</h6>

                    <div class="row g-3 mb-4">

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Name</small>
                            <span class="fw-semibold">
                                @Model.Name
                                @Model.Email
                                @Model.Phone
                            </span>
                        </div>

                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3">Event Information</h6>

                    <div class="row g-3">

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Event Type</small>
                            <span class="fw-semibold">
                                @Model.EventType
                            </span>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Service</small>
                            <span class="fw-semibold">
                                @Model.Service
                            </span>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Date</small>
                            <span class="fw-semibold">
                                @bookingDate
                            </span>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Location</small>
                            <span class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.Location)
                                                                ? "Not specified"
                                                                : Model.Location)
                            </span>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Start Time</small>
                            <span class="fw-semibold">
                                @startTime
                            </span>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Finish Time</small>
                            <span class="fw-semibold">
                                @finishTime
                            </span>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Number of Guests</small>
                            <span class="fw-semibold">
                                @Model.NumberOfPeople
                            </span>
                        </div>

                        <div class="col-sm-6">
                            <small class="text-muted d-block">Intended Budget</small>
                            <span class="fw-semibold">
                                @budget
                            </span>
                        </div>

                    </div>

                </div>
            </div>

            <!-- WhatsApp Prompt -->
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 text-center">

                    <h4 class="fw-bold mb-2">
                        What's Next?
                    </h4>

                    <p class="text-muted mb-4">
                        Continue the conversation with TM Visuals
                        to discuss your booking details and pricing.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.WhatsAppUrl))
                    {
                        <a href="@Model.WhatsAppUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-success btn-lg w-100">

                            Continue via WhatsApp

                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            WhatsApp is currently unavailable.
                            Your booking request has still been received.
                        </div>
                    }

                    <small class="text-muted d-block mt-3">
                        Your message will be prepared automatically.
                        Review it before sending.
                    </small>

                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-decoration-none">
                    Return to Homepage
                </a>
            </div>

        </div>
    </div>
</div>
