<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TM Visuals</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var page = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- The one header for every page -->
    <div class="header">
        <div class="logo">TM<br />Visuals</div>
        <div class="nav">
            <a class="@(page == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
            <a class="@(page == "Services" ? "active" : "")" asp-controller="Home" asp-action="Services">Services</a>
            <a class="@(page == "MyWork" ? "active" : "")" asp-controller="Home" asp-action="MyWork">My Work</a>
            <a class="@(page == "Profile" ? "active" : "")" asp-controller="Home" asp-action="Profile">Profile</a>
            <a href="#">Logout</a>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
