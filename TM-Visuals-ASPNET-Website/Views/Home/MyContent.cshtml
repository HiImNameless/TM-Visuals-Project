@model List<TMVisualsWebApp.Models.ClientContent>
@{
    ViewData["Title"] = "My Content";
}

<div class="container mt-4">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Profile">    <!--navigation-->
                    My Account
                </a>
            </li>
            <li class="breadcrumb-item active">
                My Content
            </li>
        </ol>
    </nav>

    <h2 class="text-white mb-4">My Content</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No content available yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6">

                    <div class="content-card">

                        <h5 class="mb-3">
                            @item.EventType
                        </h5>

                        <div class="mb-3">
                            @foreach (var service in item.Service)
                            {
                                <span class="badge service-badge me-2">
                                    @service
                                </span>
                            }
                        </div>

                        <p>
                            <strong>Date:</strong>
                            @item.BookingDate.ToString("dd MMMM yyyy")
                        </p>
                        <p>
                            <strong>Time:</strong>
                            @item.StartTime -
                            @item.EndTime
                        </p>
                        <p>
                            <strong>Location:</strong>
                            @item.Location
                        </p>
                    </div>
                    <a href="@item.DeliveryLink"
                       target="_blank"
                       class="btn btn-download mt-3">
                        Download Content
                    </a>
                </div>
            }
        </div>
    }
    <!--navigation-->
    <div class="mt-5">
        <a asp-controller="Home" 
           asp-action="Profile"
           class="btn-back">
            Back to My Account
        </a>
    </div>

</div>