@model List<TMVisualsWebApp.Models.PortfolioItem>
@{
    ViewData["Title"] = "My Work";
}

<div class="work-page">
    <section class="work-hero">
        <h1 class="main-title">Our Work in Three Words</h1>
        <div class="three-cards">
            <article class="work-card">
                <h2>Storytelling</h2>
                <p>Every frame is composed to capture the genuine atmosphere and story of your day.</p>
            </article>
            <article class="work-card work-card-highlight">
                <h2>High quality</h2>
                <p>Beautifully edited photos and videos, polished and ready to share.</p>
            </article>
            <article class="work-card">
                <h2>Variety</h2>
                <p>From wide room views to intimate moments, we capture the details that matter.</p>
            </article>
        </div>
    </section>

    <section class="selected-work">
        <h2>Selected Work</h2>

        <div class="category-filters">
            <button type="button" class="filter-btn active" data-filter="all">All</button>
            <button type="button" class="filter-btn" data-filter="Graduations">Graduations</button>
            <button type="button" class="filter-btn" data-filter="Food">Food</button>
            <button type="button" class="filter-btn" data-filter="Branding">Branding</button>
            <button type="button" class="filter-btn" data-filter="Weddings">Weddings</button>
        </div>

        @if (ViewData["PortfolioError"] is string portfolioError)
        {
            <p class="delivery-note" role="status">@portfolioError</p>
        }
        else if (Model.Count == 0)
        {
            <p class="delivery-note">New work will appear here when it is added to the portfolio.</p>
        }

        <div class="portfolio-items">
            @foreach (var item in Model)
            {
                <article class="portfolio-card" data-category="@item.Category">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        @if (string.Equals(item.MediaType, "video", StringComparison.OrdinalIgnoreCase))
                        {
                            <video controls preload="metadata" aria-label="@item.Title">
                                <source src="@item.ImageUrl" />
                            </video>
                        }
                        else
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" />
                        }
                    }
                    else
                    {
                        <div class="portfolio-placeholder" aria-hidden="true">
                            @item.Category
                        </div>
                    }
                    <div class="portfolio-card-copy">
                        <span class="portfolio-category">@item.Category</span>
                        <h3>@item.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p>@item.Description</p>
                        }
                    </div>
                </article>
            }
        </div>

        <p class="delivery-note">
            Private client delivery. Completed client content is delivered through private links and is never shown here.
        </p>
    </section>
</div>

<script>
    document.querySelectorAll('.filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filter-btn').forEach(function (b) {
                b.classList.remove('active');
            });
            btn.classList.add('active');

            var filter = btn.dataset.filter;
            document.querySelectorAll('.portfolio-card').forEach(function (card) {
                card.style.display =
                    (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
            });
        });
    });
</script>