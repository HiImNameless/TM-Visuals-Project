@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <p class="home-eyebrow">Photography and film for the moments that matter</p>
    <h1>Tell your story.<br /><span>We’ll capture it.</span></h1>
    <p class="home-intro">Explore our work or create an account to book your next shoot.</p>
    <div class="home-actions">
        <a class="home-button home-button-primary" asp-controller="Home" asp-action="MyWork">Explore our work</a>
        <a class="home-button" asp-controller="Account" asp-action="Register">Create an account</a>
        <a class="home-login-link" asp-controller="Account" asp-action="Login">Already registered? Log in</a>
    </div>
</section>
