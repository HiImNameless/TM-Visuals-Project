@model TMVisualsWebApp.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
}


<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">TM <span>Visuals</span></div>
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Log in to manage your bookings and content.</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label"></label>
                <div class="auth-password">
                    <input asp-for="Password" class="auth-input" placeholder="Your password" autocomplete="current-password" />
                    <button type="button" class="auth-toggle" data-toggle-password aria-label="Show or hide password">Show</button>
                </div>
                <span asp-validation-for="Password" class="auth-error"></span>
            </div>

            <div class="auth-check">
                <input asp-for="RememberMe" class="auth-checkbox" />
                <label asp-for="RememberMe" class="auth-check-label"></label>
            </div>

            <button type="submit" class="auth-button">Login</button>
        </form>

        <p class="auth-switch">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register">Register here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = button.parentElement.querySelector('input');
                var showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                button.textContent = showing ? 'Show' : 'Hide';
            });
        });
    </script>
}